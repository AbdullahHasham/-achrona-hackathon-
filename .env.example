# Copy this file to `.env` and fill in ONE LLM provider block. Never commit `.env`.
# Note: To replay the recorded hackathon debate in the Arcade CRT viewer (`uv run viewer`),
# NO API key and NO MCP server are required!

# ==============================================================================
# 1. LLM PROVIDER (pick ONE OpenAI-compatible block)
# ==============================================================================

# --- Option A: OpenAI (recommended for live runs) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key
MODEL_KLEIN=gpt-4.1-mini
MODEL_GROOT=gpt-4.1

# --- Option B: Google Gemini (OpenAI-compatible endpoint) ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your-gemini-api-key
# MODEL_KLEIN=gemini-2.5-flash
# MODEL_GROOT=gemini-2.5-pro

# --- Option C: OpenRouter (any model behind one key) ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# MODEL_KLEIN=openai/gpt-4.1-mini
# MODEL_GROOT=openai/gpt-4.1

# --- Option D: Local Ollama (100% offline / free) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_KLEIN=qwen3:8b
# MODEL_GROOT=qwen3:14b

# --- Option E: FreeLLMAPI (local aggregator for free tiers) ---
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=your-freellmapi-unified-key
# MODEL_KLEIN=auto:fast
# MODEL_GROOT=auto:smartest

# Optional reasoning effort for reasoning-capable models (minimal | low | medium | high)
# REASONING=medium

# ==============================================================================
# 2. KNOWLEDGE SOURCES (Self-Hosted Local MCP Server OR Local Folder Fallback)
# ==============================================================================
# Start the included 6-endpoint Streamable HTTP MCP server with:
#   uv run mcp-server   (or: python mcp_server.py)
# It serves the original synthetic `demo_scenario/` dataset on http://127.0.0.1:8200.
MCP_ARCHMAGE=http://127.0.0.1:8200/archmage/mcp
MCP_BEAST_MASTER=http://127.0.0.1:8200/beast_master/mcp
MCP_ENGINEER=http://127.0.0.1:8200/engineer/mcp
MCP_GUARDIAN_KEEPER=http://127.0.0.1:8200/guardian_keeper/mcp
MCP_HISTORIAN=http://127.0.0.1:8200/historian/mcp
MCP_ORACLE=http://127.0.0.1:8200/oracle/mcp

# Optional: Leave all MCP_<ROLE> values empty to load local `.md`/`.csv` files
# directly from `kennisbronnen/<role>/` without running an MCP server.

# Fallback rounds for synchronous wrapper (live KingOrchestrator enforces max 10 member turns)
RONDES=2
