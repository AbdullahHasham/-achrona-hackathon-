{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Debat-trace",
  "description": "Ongewijzigde uitvoer van de run die het Council Verdict maakte: wie wat inbracht, welke bronnen werden gelezen en hoe geschillen werden beslecht. Extra velden mogen.",
  "type": "object",
  "required": ["run_id", "raadsleden", "beurten", "geschillen"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Zelfde waarde als in verdict.json van dezelfde run."
    },
    "raadsleden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rol" }
    },
    "beurten": {
      "type": "array",
      "items": { "$ref": "#/$defs/beurt" }
    },
    "geschillen": {
      "type": "array",
      "items": { "$ref": "#/$defs/geschil" }
    }
  },
  "$defs": {
    "rol": {
      "enum": ["archmage", "engineer", "guardian_keeper", "historian", "oracle", "beast_master"]
    },
    "id": {
      "type": "string",
      "pattern": "^(ARC|ENG|GUA|HIS|ORA|BEA)-[0-9]{3}$"
    },
    "beurt": {
      "type": "object",
      "required": ["nr", "ronde", "spreker", "soort"],
      "properties": {
        "nr": { "type": "integer", "minimum": 1 },
        "ronde": { "type": "integer", "minimum": 0 },
        "spreker": {
          "anyOf": [
            { "$ref": "#/$defs/rol" },
            { "enum": ["voorzitter", "mens"] }
          ]
        },
        "soort": { "enum": ["bericht", "toolcall", "bestand"] }
      },
      "allOf": [
        {
          "if": { "properties": { "soort": { "const": "bericht" } } },
          "then": {
            "required": ["tekst"],
            "properties": { "tekst": { "type": "string" } }
          }
        },
        {
          "if": { "properties": { "soort": { "const": "toolcall" } } },
          "then": {
            "required": ["tool", "argumenten", "pad"],
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "argumenten": { "type": "object" },
              "pad": {
                "type": "string",
                "description": "MCP-pad, bv. https://<host>/oracle/mcp."
              }
            }
          }
        },
        {
          "if": { "properties": { "soort": { "const": "bestand" } } },
          "then": {
            "required": ["bestand"],
            "properties": {
              "bestand": {
                "type": "string",
                "description": "Kennisbron-bestand dat in de prompt ging (fallback zonder MCP), bv. oracle/visioenendagboek.md."
              }
            }
          }
        }
      ]
    },
    "geschil": {
      "type": "object",
      "required": ["onderwerp", "standpunten", "uitkomst", "bewijs"],
      "properties": {
        "onderwerp": { "type": "string", "minLength": 1 },
        "standpunten": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/rol" },
          "additionalProperties": { "type": "string" }
        },
        "uitkomst": { "type": ["string", "null"], "minLength": 1 },
        "bewijs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "if": { "properties": { "uitkomst": { "type": "string" } } },
      "then": { "properties": { "bewijs": { "minItems": 1 } } }
    }
  }
}
